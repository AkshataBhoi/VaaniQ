{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "memory": 1024,
      "maxDuration": 60,
  
      "runtime": "python3.10",
      "excludeFiles": "{node_modules/**,**/node_modules/**,**/nvidia/**,**/triton/**,**/torch/test/**,**/torch/include/**,**/*.pyc,**/__pycache__/**,**/test/**,**/tests/**,**/torch/lib/libtorch_cuda*,**/torch/lib/libnv*,**/torch/lib/libcu*,**/torch/lib/libcurand*}"
    }
  }
}