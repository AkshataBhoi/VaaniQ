{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "stanza_resources/**"
    }
  }
}